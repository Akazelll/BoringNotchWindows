{
    "$schema":  "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName":  "bento",
    "version":  "0.1.0",
    "identifier":  "com.bento.windows",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "bento",
                                    "width":  226,
                                    "height":  38,
                                    "resizable":  true,
                                    "decorations":  false,
                                    "transparent":  true,
                                    "alwaysOnTop":  true,
                                    "skipTaskbar":  true,
                                    "shadow":  false,
                                    "center":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "publisher":  "Adam Raga",
                   "copyright":  "Copyright © 2026 Adam Raga",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "windows":  {
                                   "certificateThumbprint":  "537A114A8DE7A24FDDB5EC034927EF4D6CA77678",
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  "http://timestamp.digicert.com",
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "headerImage":  "installer/header.bmp",
                                                "sidebarImage":  "installer/sidebar.bmp",
                                                "installMode":  "currentUser",
                                                "languages":  [
                                                                  "English"
                                                              ]
                                            }
                               }
               }
}
